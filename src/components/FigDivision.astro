---
// FigDivision · 配图:Skill / CLAUDE.md / Hook / MCP 四件套分工(inline SVG,双语)
export interface Props {
  locale?: 'zh' | 'en';
}

const { locale = 'zh' } = Astro.props;
const en = locale === 'en';

const T = en
  ? {
      title: 'Division of labor: CLAUDE.md holds facts, Skills hold how-to, Hooks enforce, MCP connects',
      c1: 'hard facts and rules', c1s: 'injected every session',
      c2: 'multi-step "how-to"', c2s: 'loaded on task match',
      c3: 'must-enforce actions', c3s: 'lifecycle points, no moods',
      c4: 'external data & systems', c4s: 'wire in, then teach via a skill',
    }
  : {
      title: '扩展机制分工:CLAUDE.md 管事实,Skill 管怎么做,Hook 管强制执行,MCP 管外部连接',
      c1: '硬性事实与规矩', c1s: '每个会话启动即注入',
      c2: '多步骤的「怎么做」', c2s: '任务匹配按需加载',
      c3: '必须强制执行的动作', c3s: '生命周期节点,不看心情',
      c4: '连接外部数据与系统', c4s: '接入后用 Skill 教它用好',
    };
---

<figure class="fig">
  <svg viewBox="0 0 760 330" role="img" aria-labelledby="fig-division-title" style="width:100%;height:auto;display:block">
    <title id="fig-division-title">{T.title}</title>
    <g style="font-family:var(--mono);font-size:11px">
      <rect x="305" y="135" width="150" height="60" rx="30" fill="var(--term-bg)" stroke="var(--term-edge)"/>
      <text x="380" y="170" fill="#7CE3A5" text-anchor="middle" font-weight="700" style="font-size:13px">claude</text>
      <path d="M330 135 L210 96" stroke="var(--line-strong)" stroke-width="1.5"/>
      <path d="M430 135 L550 96" stroke="var(--line-strong)" stroke-width="1.5"/>
      <path d="M330 195 L210 234" stroke="var(--line-strong)" stroke-width="1.5"/>
      <path d="M430 195 L550 234" stroke="var(--line-strong)" stroke-width="1.5"/>
      <rect x="8" y="20" width="230" height="86" rx="10" fill="var(--panel)" stroke="var(--line-strong)"/>
      <text x="24" y="46" fill="var(--hl)" font-weight="700" style="font-size:12.5px">CLAUDE.md</text>
      <text x="24" y="68" fill="var(--ink)">{T.c1}</text>
      <text x="24" y="88" fill="var(--faint)" style="font-size:10.5px">{T.c1s}</text>
      <rect x="522" y="20" width="230" height="86" rx="10" fill="var(--panel)" stroke="var(--line-strong)"/>
      <text x="538" y="46" fill="#7CE3A5" font-weight="700" style="font-size:12.5px">Skill</text>
      <text x="538" y="68" fill="var(--ink)">{T.c2}</text>
      <text x="538" y="88" fill="var(--faint)" style="font-size:10.5px">{T.c2s}</text>
      <rect x="8" y="224" width="230" height="86" rx="10" fill="var(--panel)" stroke="var(--line-strong)"/>
      <text x="24" y="250" fill="var(--danger)" font-weight="700" style="font-size:12.5px">Hook</text>
      <text x="24" y="272" fill="var(--ink)">{T.c3}</text>
      <text x="24" y="292" fill="var(--faint)" style="font-size:10.5px">{T.c3s}</text>
      <rect x="522" y="224" width="230" height="86" rx="10" fill="var(--panel)" stroke="var(--line-strong)"/>
      <text x="538" y="250" fill="var(--blue)" font-weight="700" style="font-size:12.5px">MCP</text>
      <text x="538" y="272" fill="var(--ink)">{T.c4}</text>
      <text x="538" y="292" fill="var(--faint)" style="font-size:10.5px">{T.c4s}</text>
    </g>
  </svg>
</figure>

<style>
  .fig { margin: 26px 0; }
</style>
