---
// MemoryTree ★签名元素 · 记忆加载层级图(双语)
import Term from './Term.astro';

export interface Props {
  locale?: 'zh' | 'en';
}

const { locale = 'zh' } = Astro.props;
const en = locale === 'en';
---

{en ? (
  <Term title="memory-hierarchy" aria-label="Memory loading hierarchy diagram"><span class="tree-row"><span class="t-b">~/.claude/</span></span><span class="tree-row">├── CLAUDE.md            <span class="t-c">← global</span><span class="t-badge">on startup</span></span><span class="tree-row">└── <span class="t-b">skills/</span>              <span class="t-c">← personal skills · all projects</span></span><span class="tree-row"> </span><span class="tree-row"><span class="t-b">~/work/my-app/</span>           <span class="t-c">← you run</span> <span class="t-g">claude</span> <span class="t-c">here</span><span class="caret"></span></span><span class="tree-row">├── CLAUDE.md            <span class="t-c">← project · shared via git</span><span class="t-badge">on startup</span></span><span class="tree-row">├── CLAUDE.local.md      <span class="t-c">← personal prefs</span><span class="t-badge local">gitignore</span></span><span class="tree-row">├── <span class="t-b">.claude/skills/</span>      <span class="t-c">← project skills</span></span><span class="tree-row">└── <span class="t-b">src/</span></span><span class="tree-row">    └── CLAUDE.md        <span class="t-c">← directory rules</span><span class="t-badge lazy">lazy</span></span><span class="tree-row"> </span><span class="tree-row"><span class="t-c"># startup walks up from cwd collecting CLAUDE.md;</span></span><span class="tree-row"><span class="t-c"># subdir files inject when Claude reads that dir;</span></span><span class="tree-row"><span class="t-c"># sibling directories never interfere.</span></span></Term>
) : (
  <Term title="memory-hierarchy — 记忆加载层级" aria-label="记忆加载层级示意图"><span class="tree-row"><span class="t-b">~/.claude/</span></span><span class="tree-row">├── CLAUDE.md            <span class="t-c">← 全局</span><span class="t-badge">启动加载</span></span><span class="tree-row">└── <span class="t-b">skills/</span>              <span class="t-c">← 个人 Skills · 全项目可用</span></span><span class="tree-row"> </span><span class="tree-row"><span class="t-b">~/work/my-app/</span>           <span class="t-c">← 你在这里运行</span> <span class="t-g">claude</span><span class="caret"></span></span><span class="tree-row">├── CLAUDE.md            <span class="t-c">← 项目 · 随 git 共享</span><span class="t-badge">启动加载</span></span><span class="tree-row">├── CLAUDE.local.md      <span class="t-c">← 个人偏好</span><span class="t-badge local">gitignore</span></span><span class="tree-row">├── <span class="t-b">.claude/skills/</span>      <span class="t-c">← 项目 Skills</span></span><span class="tree-row">└── <span class="t-b">src/</span></span><span class="tree-row">    └── CLAUDE.md        <span class="t-c">← 目录级规则</span><span class="t-badge lazy">懒加载</span></span><span class="tree-row"> </span><span class="tree-row"><span class="t-c"># 启动时自 cwd 向上收集所有 CLAUDE.md;</span></span><span class="tree-row"><span class="t-c"># 子目录的等 Claude 读到该目录文件才注入;</span></span><span class="tree-row"><span class="t-c"># 兄弟目录互不打扰。</span></span></Term>
)}
