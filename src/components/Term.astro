---
// Term · 终端面板
import CopyButton from './CopyButton.astro';

export interface Props {
  title: string;
  copyText?: string;
  copyTarget?: string;
  copyLabel?: string;
  copyDoneLabel?: string;
  codeId?: string;
  /** 直接传入代码文本(避免 slot 缩进空白混入 <pre>,保证复制/下载逐字节干净) */
  content?: string;
  'aria-label'?: string;
}

const { title, copyText, copyTarget, copyLabel, copyDoneLabel, codeId, content } = Astro.props;
const ariaLabel = Astro.props['aria-label'] ?? title;
const showCopy = copyText || copyTarget;
---

<div class="term" aria-label={ariaLabel}>
  <div class="term-bar">
    <span class="tdot"></span>
    <span class="tdot"></span>
    <span class="tdot"></span>
    <span class="term-title">{title}</span>
    {showCopy && <CopyButton text={copyText} target={copyTarget} label={copyLabel} doneLabel={copyDoneLabel} />}
    <slot name="actions" />
  </div>
  <pre><code id={codeId ?? undefined}>{content !== undefined ? content : <slot />}</code></pre>
</div>
