---
// Plate · 手册铭牌(双语)
export interface Props {
  locale?: 'zh' | 'en';
}

const { locale = 'zh' } = Astro.props;
const en = locale === 'en';
---

<header class="plate">
  <div class="wrap">
    <div class="plate-in">
      <div class="plate-cell"><b>CC·FIELD MANUAL</b></div>
      <div class="plate-cell hide-m">{en ? 'No. CCA-2026-07' : '编号 CCA-2026-07'}</div>
      <div class="plate-cell hide-m">{en ? 'For Claude Code v2.x' : '适用 Claude Code v2.x'}</div>
      <div class="plate-cell grow"><span class="plate-stamp">{en ? 'LIVING DOC' : '持续修订'}</span></div>
    </div>
  </div>
</header>
