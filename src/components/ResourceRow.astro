---
// ResourceRow · 资源行(基准 .res,三栏;≤820px 折单栏;双语)
import type { CollectionEntry } from 'astro:content';
import CopyButton from './CopyButton.astro';

export interface Props {
  resource: CollectionEntry<'resources'>['data'];
  locale?: 'zh' | 'en';
}

const { resource: r, locale = 'zh' } = Astro.props;
const en = locale === 'en';

const badgeClass = r.badge === '中文' ? 'tagx cn' : r.badge === '安全' ? 'tagx sec' : 'tagx';
const badgeEn: Record<string, string> = {
  官方: 'OFFICIAL', 市场: 'MARKET', 导航: 'INDEX', 合辑: 'BUNDLE', 中文: 'ZH', 垂直: 'DOMAIN', 安全: 'SECURITY',
};
const badgeLabel = en ? badgeEn[r.badge] : r.badge;
const desc = en ? (r.descEn ?? r.desc) : r.desc;
const copyLabel = en ? 'copy' : (r.installLabel ?? '复制安装');
---

<div class="res">
  <div class="res-name">
    {r.url
      ? <a href={r.url} target="_blank" rel="noopener">{r.name}<span class="ext">↗</span></a>
      : r.name}
  </div>
  <div class="res-desc">{desc}</div>
  <div class="res-meta">
    <span class={badgeClass}>{badgeLabel}</span>
    {r.stars && <span class="star">★ {r.stars}</span>}
    {r.installCommand && (
      <CopyButton text={r.installCommand} variant="light" label={copyLabel} doneLabel={en ? 'copied ✓' : undefined} />
    )}
  </div>
</div>
