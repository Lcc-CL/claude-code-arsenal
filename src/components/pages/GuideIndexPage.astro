---
// GuideIndexPage · 学习指南索引(双语共享版式)
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import ChapterHead from '../ChapterHead.astro';

export interface Props {
  locale?: 'zh' | 'en';
}

const { locale = 'zh' } = Astro.props;
const en = locale === 'en';

const guides = (await getCollection('guides'))
  .filter(g => g.id.startsWith('en/') === en)
  .sort((a, b) => a.data.order - b.data.order);

const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

const T = en
  ? {
      title: 'Guides — Claude Code Arsenal',
      description: 'CLAUDE.md writing rules, SKILL.md anatomy, troubleshooting, and a glossary — the four essential reads for using skills and memory well.',
      h2: 'Four essential reads',
      lede: 'Writing rules, field-by-field anatomy, troubleshooting, and a glossary — all distilled from official docs and community best practice.',
      updated: 'updated',
      href: (id: string) => `/en/guide/${id.slice(3)}`,
    }
  : {
      title: '学习指南 — Claude Code Arsenal · 装备手册',
      description: 'CLAUDE.md 编写守则、SKILL.md 逐字段剖析、高频排障与术语表——把 Skills 与记忆用对的四篇必读。',
      h2: '把技能与记忆用对的四篇必读',
      lede: '编写守则、逐字段剖析、高频排障与术语表;全部依据官方文档与社区最佳实践整理。',
      updated: '更新于',
      href: (id: string) => `/guide/${id}`,
    };
---

<Site locale={locale} title={T.title} description={T.description}>
  <section class="ch" id="guides" style="border-bottom:none">
    <div class="wrap">
      <ChapterHead tag="$ man arsenal · GUIDES" title={T.h2} lede={T.lede} />
      <div class="cards reveal">
        {guides.map(g => (
          <div class="card">
            <div class="card-top">
              <span class="card-name"><a href={T.href(g.id)}>{g.data.title}</a></span>
            </div>
            <p class="card-desc">{g.data.description}</p>
            <div class="guide-card-meta">GUIDE 0{g.data.order} · {T.updated} {fmt(g.data.updatedAt)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Site>

<style>
  .card-name a { color: var(--ink); border-bottom: none; }
  .card-name a:hover { color: var(--blue); }
</style>
