---
// 首页:铭牌 + Hero(记忆层级图)+ 三步快速开始 + 精选入口(SPEC 第 6 节)
import { getCollection } from 'astro:content';
import Site from '../layouts/Site.astro';
import Term from '../components/Term.astro';
import ArmingTerminal from '../components/ArmingTerminal.astro';
import SkillCard from '../components/SkillCard.astro';
import ResourceRow from '../components/ResourceRow.astro';
import ChapterHead from '../components/ChapterHead.astro';

const skills = (await getCollection('skills')).map(e => e.data);
const officialCount = skills.filter(s => s.origin === 'official').length;
const resources = (await getCollection('resources')).map(e => e.data).sort((a, b) => a.order - b.order);
const featuredSkills = skills.filter(s => s.featured).sort((a, b) => a.order - b.order).slice(0, 3);
const featuredResources = resources.slice(0, 3);

// astro check 的 TSX 转换不接受模板文本里的换行转义字面量,统一走常量
const nl = '\n';

const step2Copy = `/plugin marketplace add anthropics/skills
/plugin install document-skills@anthropic-agent-skills
/plugin install example-skills@anthropic-agent-skills`;
---

<Site
  title="Claude Code Arsenal · 装备手册 — Skills 与 CLAUDE.md 精选库"
  description="精选 Anthropic 官方 Skills、权威社区资源与全局/项目/目录级 CLAUDE.md 模板,附完整开发者使用说明。"
>
  <!-- HERO v2 · 装配序列 -->
  <div class="hero-v2">
    <div class="wrap">
      <div class="hero-grid">
        <div class="reveal">
          <div class="eyebrow">CC·FIELD MANUAL / EST. 2026</div>
          <h1 class="hero-slogan-en"><span class="ghost" aria-hidden="true">ARM YOUR<br>AGENT</span>ARM YOUR<br>AGENT<span class="cursor" aria-hidden="true"></span></h1>
          <p class="hero-slogan-zh">把 Claude Code <span class="hl">武装到牙齿</span>。</p>
          <p class="hero-lede">精选 Skills × 四层 CLAUDE.md 记忆模板 × 权威社区资源。每一件装备都注明来源、给出安装命令、附上开口就能用的调用示例——复制,粘贴,开工。</p>
          <div class="hero-stats">
            <div class="stat"><b>{skills.length}</b>收录 Skills</div>
            <div class="stat"><b>{officialCount}</b>官方出品</div>
            <div class="stat"><b>{resources.length}</b>权威资源库</div>
            <div class="stat"><b>4</b>层记忆模板</div>
          </div>
        </div>
        <div class="reveal">
          <ArmingTerminal
            skills={skills.map(s => ({ n: s.name, c: s.install.command, o: s.origin }))}
            resources={resources.map(r => r.name)}
            officialCount={officialCount}
          />
        </div>
      </div>
    </div>
  </div>

  <!-- 快速开始 -->
  <section class="ch" id="start">
    <div class="wrap">
      <ChapterHead
        tag="$ claude --setup · QUICKSTART"
        title="三条命令,完成全套装配"
        lede="从零开始到「官方技能全就位 + 项目记忆初始化」,总共只需要几分钟。每个代码块右上角都可以一键复制。"
      />
      <div class="steps reveal">
        <div class="step">
          <div class="step-no">STEP 01 — 安装 Claude Code</div>
          <Term title="terminal" copyText="npm install -g @anthropic-ai/claude-code"><span class="t-g">$</span> npm install -g @anthropic-ai/claude-code{nl}<span class="t-g">$</span> cd 你的项目 <span class="t-g">&&</span> claude</Term>
          <p>已安装可跳过。首次运行会引导登录;详细系统要求见文末官方文档链接。</p>
        </div>
        <div class="step">
          <div class="step-no">STEP 02 — 接入官方技能市场</div>
          <Term title="claude · 会话内执行" copyText={step2Copy}><span class="t-g">&gt;</span> /plugin marketplace add <span class="t-y">anthropics/skills</span>{nl}<span class="t-g">&gt;</span> /plugin install document-skills@anthropic-agent-skills{nl}<span class="t-g">&gt;</span> /plugin install example-skills@anthropic-agent-skills</Term>
          <p>一次装齐第 02 章的 17 个官方 Skills。之后在对话里点名即可使用,例如「用 pdf skill 提取这份表单的字段」。</p>
        </div>
        <div class="step">
          <div class="step-no">STEP 03 — 初始化记忆</div>
          <Term title="claude · 会话内执行" copyText="/init"><span class="t-g">&gt;</span> /init   <span class="t-c"># 自动生成项目 CLAUDE.md 草稿</span>{nl}<span class="t-g">&gt;</span> /memory <span class="t-c"># 随时查看 / 编辑各层记忆</span></Term>
          <p>生成草稿后,用第 04 章的模板对照修剪:删掉 Claude 自己能推断的内容,只留高信号规则。全局文件手动放到 <span class="mono" style="font-size:12px">~/.claude/CLAUDE.md</span>。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 精选入口 -->
  <section class="ch" id="featured" style="border-bottom:none">
    <div class="wrap">
      <ChapterHead
        tag="$ ls featured/ · 精选"
        title="先从这几件装备开始"
        lede="技能库与资源库的入口精选;完整收录请进各自页面。"
      />
      <div class="cards reveal">
        {featuredSkills.map(skill => <SkillCard skill={skill} />)}
      </div>
      <p class="bundle-note"><a href="/skills">查看全部 {skills.length} 个 Skills →</a></p>
      <div class="res-list reveal" style="margin-top:26px">
        {featuredResources.map(resource => <ResourceRow resource={resource} />)}
      </div>
      <p class="bundle-note"><a href="/resources">查看全部 {resources.length} 席资源 →</a></p>
    </div>
  </section>
</Site>
