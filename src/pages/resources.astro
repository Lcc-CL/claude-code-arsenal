---
// /resources · 社区资源库(文案平移自基准第 03 章)
import { getCollection } from 'astro:content';
import Site from '../layouts/Site.astro';
import ChapterHead from '../components/ChapterHead.astro';
import ResourceRow from '../components/ResourceRow.astro';

const resources = (await getCollection('resources')).map(e => e.data).sort((a, b) => a.order - b.order);
---

<Site
  title="资源库 — Claude Code Arsenal · 装备手册"
  description="权威社区资源库精选 12 席:官方仓库、技能市场、精选导航、中文合集与安全审计工具,带命令的可直接复制安装。"
>
  <section class="ch" id="community" style="border-bottom:none">
    <div class="wrap">
      <ChapterHead
        tag="第 03 章 / COMMUNITY"
        title="权威社区资源库 · 精选 12 席"
        lede="官方之外,这些是社区公认的高质量集散地——从技能市场、精选清单到中文原创合集与安全审计工具。带命令的可直接复制安装。"
      />
      <div class="res-list reveal">
        {resources.map(resource => <ResourceRow resource={resource} />)}
      </div>
      <p class="fineprint">★ 星数为编写时的快照(社区数据随时间变化),以各仓库实际为准;未附链接的条目在 GitHub 按名称搜索即达首位。</p>
    </div>
  </section>
</Site>
