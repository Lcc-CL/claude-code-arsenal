---
// /guide/[slug] · 单篇指南:左内容右自动 TOC(≤980px 隐藏 TOC)
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Site from '../../layouts/Site.astro';
import ChapterHead from '../../components/ChapterHead.astro';

export const getStaticPaths = (async () => {
  const guides = await getCollection('guides');
  return guides.map(g => ({ params: { slug: g.id }, props: { guide: g } }));
}) satisfies GetStaticPaths;

const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const toc = headings.filter(h => h.depth <= 3);
---

<Site
  title={`${guide.data.title} — 学习指南 · Claude Code Arsenal`}
  description={guide.data.description}
>
  <section class="ch" style="border-bottom:none">
    <div class="wrap">
      <ChapterHead
        tag={`学习指南 / GUIDE 0${guide.data.order}`}
        title={guide.data.title}
        lede={guide.data.description}
      />
      <div class="guide-layout">
        <div class="guide-body reveal">
          <Content />
          <p class="fig-note" style="margin-top:34px"><a href="/guide">← 返回指南索引</a></p>
        </div>
        {toc.length > 0 && (
          <nav class="guide-toc" aria-label="本页目录">
            <div class="guide-toc-tag">ON THIS PAGE</div>
            {toc.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}
          </nav>
        )}
      </div>
    </div>
  </section>
</Site>
