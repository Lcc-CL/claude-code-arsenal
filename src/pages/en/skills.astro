---
// /en/skills · skills directory with category × origin filters
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import ChapterHead from '../../components/ChapterHead.astro';
import FilterBar from '../../components/FilterBar.astro';
import SkillCard from '../../components/SkillCard.astro';

const skills = (await getCollection('skills')).map(e => e.data).sort((a, b) => a.order - b.order);
const officialCount = skills.filter(s => s.origin === 'official').length;
const communityCount = skills.length - officialCount;
---

<Site
  locale="en"
  title="Skills — Claude Code Arsenal"
  description="All official Anthropic skills plus vetted community picks: documents, engineering, creative, and teamwork — filterable, with install commands and usage prompts."
>
  <section class="ch" id="official" style="border-bottom:none">
    <div class="wrap">
      <ChapterHead
        tag="$ ls ~/.claude/skills/ · SKILLS"
        title={`All ${officialCount} official · ${communityCount} community picks and counting`}
        ledeHtml='Official entries come straight from the public <a href="https://github.com/anthropics/skills" target="_blank" rel="noopener">github.com/anthropics/skills</a> repo; community entries are verified against authoritative charts before inclusion. Each skill is a self-contained folder with a SKILL.md — Claude loads it automatically on task match, or you can call it by name.'
      />
      <FilterBar locale="en" cards={skills.map(s => ({ category: s.category, origin: s.origin }))} />
      <div class="cards reveal">
        {skills.map(skill => <SkillCard skill={skill} locale="en" />)}
      </div>
      <p class="bundle-note">※ The official skills above are installed by the two /plugin install lines in STEP 02; Claude.ai paid plans have them built in. Each skill keeps only ~100 tokens of metadata resident — progressive disclosure means even a full rack won't slow your session.</p>
    </div>
  </section>
</Site>
