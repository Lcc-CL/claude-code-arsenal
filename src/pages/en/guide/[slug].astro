---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import GuideDetailPage from '../../../components/pages/GuideDetailPage.astro';

export const getStaticPaths = (async () => {
  const guides = (await getCollection('guides')).filter(g => g.id.startsWith('en/'));
  return guides.map(g => ({ params: { slug: g.id.slice(3) }, props: { guide: g } }));
}) satisfies GetStaticPaths;

const { guide } = Astro.props;
---
<GuideDetailPage guide={guide} locale="en" />
