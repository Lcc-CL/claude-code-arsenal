---
// /en/resources · community resource shelf
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import ChapterHead from '../../components/ChapterHead.astro';
import ResourceRow from '../../components/ResourceRow.astro';

const resources = (await getCollection('resources')).map(e => e.data).sort((a, b) => a.order - b.order);
---

<Site
  locale="en"
  title="Resources — Claude Code Arsenal"
  description="Authoritative community resources: official repos, skill markets, curated indexes, Chinese-language collections, and security auditing tools — install commands included."
>
  <section class="ch" id="community" style="border-bottom:none">
    <div class="wrap">
      <ChapterHead
        tag="$ curl community/ · RESOURCES"
        title={`The community shelf · ${resources.length} picks`}
        lede="Beyond the official repos, these are the community's recognized hubs — from skill markets and curated lists to domain collections and security auditing tools. Entries with a command are copy-to-install."
      />
      <div class="res-list reveal">
        {resources.map(resource => <ResourceRow resource={resource} locale="en" />)}
      </div>
      <p class="fineprint">★ Star counts are snapshots refreshed weekly by CI (community numbers drift); trust each repo's live number. Entries without links rank first on GitHub for their names.</p>
    </div>
  </section>
</Site>
